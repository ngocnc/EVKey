{
  "productName": "EVKey",
  "identifier": "com.chrisnguyen.evkey",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null
    },
    "windows": [
      {
        "label": "settings",
        "title": "EVKey - Cài đặt",
        "url": "settings.html",
        "width": 980,
        "height": 760,
        "minWidth": 760,
        "minHeight": 480,
        "center": true,
        "visible": false,
        "transparent": true,
        "windowEffects": { "effects": ["acrylic"] }
      }
    ]
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}
