{
  "productName": "EVKey",
  "identifier": "com.chrisnguyen.evkey",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null
    },
    "windows": [
      {
        "label": "settings",
        "create": false,
        "title": "EVKey - Cài đặt",
        "url": "settings.html",
        "width": 980,
        "height": 760,
        "minWidth": 760,
        "minHeight": 480,
        "center": true,
        "visible": false,
        "transparent": true,
        "windowEffects": { "effects": ["acrylic"], "color": [30, 24, 36, 0] }
      },
      {
        "label": "update",
        "create": false,
        "title": "EVKey",
        "url": "update.html",
        "width": 480,
        "height": 460,
        "center": true,
        "resizable": false,
        "minimizable": false,
        "maximizable": false,
        "alwaysOnTop": true,
        "visible": false,
        "transparent": true,
        "windowEffects": { "effects": ["acrylic"], "color": [30, 24, 36, 0] }
      },
      {
        "label": "popup",
        "title": "EVKey",
        "url": "popup.html",
        "width": 320,
        "height": 300,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": true,
        "focus": true,
        "visible": false
      },
      {
        "label": "actions",
        "title": "EVKey",
        "url": "actions.html",
        "width": 340,
        "height": 80,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": true,
        "focus": false,
        "visible": false
      },
      {
        "label": "banner",
        "title": "EVKey Banner",
        "url": "banner.html",
        "width": 360,
        "height": 64,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false,
        "visible": false
      }
    ]
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}
